<Project>
  <PropertyGroup>
    <!-- Audit direct and transitive packages. Keep lower-severity findings visible,
         but fail restore on audit-feed errors and high/critical vulnerabilities. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
