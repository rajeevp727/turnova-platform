# TriSend authentication service (HTTPS only)
TriSend__BaseUrl=https://auth.trisend.rajeevstech.in
# These three values MUST exactly match TriSend Auth:Jwt settings.
Auth__Jwt__Issuer=YOUR-TRISEND-JWT-ISSUER
Auth__Jwt__Audience=YOUR-TRISEND-JWT-AUDIENCE
Auth__Jwt__SigningKey=YOUR-TRISEND-JWT-SIGNING-KEY-32-CHARS-MINIMUM

# Optional Cosmos DB settings
CosmosDb__Endpoint=https://YOUR-ACCOUNT.documents.azure.com:443/
CosmosDb__Key=YOUR-COSMOS-PRIMARY-KEY
CosmosDb__DatabaseName=TurnOvaDb

# Rider discovery radius (km); 0 is an intentionally unconfigured placeholder and disables discovery.
Dispatch__NearbyRadiusKm=0

# Selected-driver negotiation lifetime (seconds); 0 is an intentionally unapproved placeholder and disables booking.
Dispatch__SelectedDriverNegotiationLifetimeSeconds=0
# Server-side expiry worker polling interval (seconds).
Dispatch__SelectedDriverBookingExpiryPollIntervalSeconds=5
