{
  "name": "turnova-driver",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.mjs",
    "prestart": "npm run generate-icons",
    "preandroid": "npm run generate-icons",
    "preios": "npm run generate-icons",
    "postinstall": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-asset": "~12.0.9",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "expo-secure-store": "~15.0.7",
    "expo-location": "~19.0.7",
    "@microsoft/signalr": "10.0.0",
    "expo-file-system": "~19.0.21",
    "expo-sharing": "~14.0.7",
    "react-native-svg": "~15.12.1",
    "sharp": "0.35.5",
    "expo-image-picker": "~17.0.8",
    "expo-image-manipulator": "~14.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "image-size": "2.1.0",
    "postcss": "8.5.32"
  }
